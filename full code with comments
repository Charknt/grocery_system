class Page(tk.Frame):
    # A generic "blank page" that every screen in the app (Dashboard,
    # Products, Suppliers, etc.) is built on top of. It just provides
    # some shared helper methods so every page looks consistent.
    def __init__(self, master):
        super().__init__(master, bg=BG)

    def page_header(self, title, subtitle=""):
        # Draws the big bold title at the top of a page (and an optional
        # smaller subtitle next to it). Returns the header frame so the
        # page can add extra buttons (like "+ Add Product") into it.
        f = tk.Frame(self, bg=BG)
        f.pack(fill="x", padx=28, pady=(16, 4))
        tk.Label(f, text=title, bg=BG, fg=DARK,
                 font=("Segoe UI", 18, "bold")).pack(side="left")
        if subtitle:
            tk.Label(f, text=f"  |  {subtitle}", bg=BG, fg=MUTED,
                     font=("Segoe UI", 10, "italic")).pack(side="left", pady=6)
        return f

    def divider(self):
        # Draws a thin horizontal line across the page, used to visually
        # separate sections (like between the stat cards and the table).
        tk.Frame(self, bg=ACCENT, height=2).pack(fill="x", padx=28, pady=10)


# ══════════════════════════════════════════════════════════════════
#  DASHBOARD
# ══════════════════════════════════════════════════════════════════

class DashboardPage(Page):
    # The home screen of the app. Shows clickable summary "cards"
    # (Today's Sales, Low Stock, Near Expiry, etc.) and a table below
    # that updates depending on which card is currently selected.
    def __init__(self, master):
        super().__init__(master)
        self.page_header("Dashboard", "Interactive Store Overview")
        
        self.selected_view = tk.StringVar(value="low_stock")
        self.cards_dict = {}  
        self._build()

    def _stats(self):
        # Runs several database queries to calculate the numbers shown on
        # the dashboard cards: today's total sales, how many batches are
        # active, how many are low on stock, near expiry, expired, or
        # already disposed of. Returns all of these numbers together.
        today = datetime.now().strftime("%Y-%m-%d")
        with db_conn() as c:
            sales_today   = c.execute("SELECT SUM(total_amount) FROM sales WHERE sale_date = ? AND status = 'active'", (today,)).fetchone()[0] or 0.0
            total_batches = c.execute("SELECT COUNT(*) FROM product_batch WHERE quantity_remaining > 0 AND status = 'active' AND (expiry_date >= ? OR expiry_date IS NULL)", (today,)).fetchone()[0]
            low_batches   = c.execute("SELECT COUNT(*) FROM product_batch WHERE quantity_remaining > 0 AND quantity_remaining <= 15 AND status = 'active' AND (expiry_date >= ? OR expiry_date IS NULL)", (today,)).fetchone()[0]
            near_expiry   = c.execute("""
                SELECT COUNT(*) FROM product_batch 
                WHERE quantity_remaining > 0 
                AND status = 'active'
                AND expiry_date IS NOT NULL 
                AND expiry_date >= ? 
                AND expiry_date <= date(?, '+30 days')
            """, (today, today)).fetchone()[0]
            expired       = c.execute("SELECT COUNT(*) FROM product_batch WHERE quantity_remaining > 0 AND status = 'active' AND expiry_date < ?", (today,)).fetchone()[0]
            disposed      = c.execute("SELECT COUNT(*) FROM product_batch WHERE status = 'disposed'").fetchone()[0]
            
        return sales_today, total_batches, low_batches, near_expiry, expired, disposed

    def _build(self):
        # Builds the whole dashboard layout: gets the stats, draws the
        # row of stat cards, draws the title/description above the table,
        # adds the "Let Go of Batch" (dispose) button, and creates the
        # table that lists whichever view is currently selected.
        sales_today, total_batches, low_batches, near_expiry, expired, disposed = self._stats()

        self.card_row = tk.Frame(self, bg=BG)
        self.card_row.pack(fill="x", padx=28, pady=(0, 6))

        card_data = [
            ("💰", "Today's Sales",   f"₱{sales_today:.2f}", DARK, "today_sales"),
            ("📦", "Active Batches",   str(total_batches),    DARK, "all_batches"),
            ("⚠",  "Low Stock",        str(low_batches),      RED,  "low_stock"),
            ("⏳",  "Near Expiry (30d)",str(near_expiry),     GREEN,"near_expiry"),
            ("❌",  "Expired Status",   str(expired),          MUTED,"expired"),
            ("🗑",  "Disposed / Let Go", str(disposed),         MUTED,"disposed"),
        ]
        
        for icon, label, val, color, target in card_data:
            self._stat_card(self.card_row, icon, label, val, color, target)

        self.divider()

        title_and_btn_frame = tk.Frame(self, bg=BG)
        title_and_btn_frame.pack(fill="x", padx=28, pady=(0, 4))

        text_container = tk.Frame(title_and_btn_frame, bg=BG)
        text_container.pack(side="left", fill="y")

        self.table_title_var = tk.StringVar(value="⚠  Low Stock Batches")
        self.table_desc_var = tk.StringVar(value="Batches with 15 or fewer items remaining.")        
        tk.Label(text_container, textvariable=self.table_title_var, bg=BG, fg=DARK, font=("Segoe UI", 11, "bold")).pack(anchor="w")
        tk.Label(text_container, textvariable=self.table_desc_var, bg=BG, fg=MUTED, font=("Segoe UI", 8)).pack(anchor="w")

        self.dispose_btn = make_btn(title_and_btn_frame, "🗑 Let Go of Batch", self._dispose_batch, danger=True)
        self.dispose_btn.pack(side="right", pady=4)

        self.table_wrap, self.tree = make_tree(self, ["Product Name", "Batch ID", "Qty Remaining", "Expiry Date"], height=12)
        self.table_wrap.pack(fill="both", expand=True, padx=28, pady=(0, 16))

        self._update_card_colors()
        self._refresh_dashboard_list()

    def _stat_card(self, parent, icon, label, val, color, target):
        # Builds one clickable summary "card" (icon + number + label),
        # e.g. the "Low Stock" card. Clicking anywhere on the card switches
        # the dashboard's table to show that category ("target").
        card = tk.Frame(parent, bg=PANEL, highlightthickness=1, highlightbackground=ACCENT, relief="raised", bd=1, cursor="hand2")
        card.pack(side="left", expand=True, fill="both", padx=4, ipady=4)
        
        val_font = ("Segoe UI", 13, "bold") if "₱" in val else ("Segoe UI", 18, "bold")
        
        l1 = tk.Label(card, text=icon, bg=PANEL, fg=color, font=("Segoe UI", 14), cursor="hand2")
        l1.pack(pady=(6, 0))
        l2 = tk.Label(card, text=val, bg=PANEL, fg=color, font=val_font, cursor="hand2")
        l2.pack()
        l3 = tk.Label(card, text=label, bg=PANEL, fg=TEXT, font=("Segoe UI", 8, "bold"), cursor="hand2")
        l3.pack(pady=(0, 6))

        self.cards_dict[target] = {
            "card": card,
            "labels": [l1, l2, l3],
            "default_fg": [color, color, TEXT]
        }

        def on_click(event):
            self.selected_view.set(target)
            self._update_card_colors()
            self._refresh_dashboard_list()

        card.bind("<Button-1>", on_click)
        l1.bind("<Button-1>", on_click)
        l2.bind("<Button-1>", on_click)
        l3.bind("<Button-1>", on_click)

    def _update_card_colors(self):
        # Visually highlights whichever card is currently selected (turns
        # it blue) and resets all the other cards back to their normal
        # white/colored look, so the user can see at a glance which view
        # is active.
        active_target = self.selected_view.get()
        
        for target, widgets in self.cards_dict.items():
            if target == active_target:
                widgets["card"].configure(bg=MID_BLU, highlightbackground=DARK, relief="sunken")
                for lbl in widgets["labels"]:
                    lbl.configure(bg=MID_BLU)
                widgets["labels"][0].configure(fg=PANEL)
                widgets["labels"][1].configure(fg=PANEL)
                widgets["labels"][2].configure(fg=PANEL, font=("Segoe UI", 8, "bold"))
            else:
                widgets["card"].configure(bg=PANEL, highlightbackground=ACCENT, relief="raised")
                for i, lbl in enumerate(widgets["labels"]):
                    lbl.configure(bg=PANEL, fg=widgets["default_fg"][i])
                widgets["labels"][2].configure(font=("Segoe UI", 8, "bold"))

    def _dispose_batch(self):
        # Runs when the "Let Go of Batch" button is clicked. Checks that
        # a valid batch row is selected in the table, asks the user to
        # confirm, then marks that batch as "disposed" in the database
        # (removing it from active stock counts) and refreshes the
        # dashboard numbers and table.
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Selection Missing", "Please select a row from the list below to dispose.")
            return
            
        values = self.tree.item(sel[0])["values"]
        if not values or self.selected_view.get() == "today_sales" or "No batch" in str(values[0]):
            messagebox.showwarning("Invalid Selection", "Please choose a valid active batch record.")
            return
            
        batch_id = values[1]
        
        if not messagebox.askyesno("Dispose Inventory Batch", f"Are you sure you want to write-off/dispose batch [{batch_id}]?\nThis will take its items completely off structural active stock calculations."):
            return
            
        with db_conn() as c:
            c.execute("UPDATE product_batch SET status = 'disposed' WHERE batch_id = ?", (batch_id,))
            
        sales_today, total_batches, low_batches, near_expiry, expired, disposed = self._stats()
        self.cards_dict["today_sales"]["labels"][1].configure(text=f"₱{sales_today:.2f}")
        self.cards_dict["all_batches"]["labels"][1].configure(text=str(total_batches))
        self.cards_dict["low_stock"]["labels"][1].configure(text=str(low_batches))
        self.cards_dict["near_expiry"]["labels"][1].configure(text=str(near_expiry))
        self.cards_dict["expired"]["labels"][1].configure(text=str(expired))
        self.cards_dict["disposed"]["labels"][1].configure(text=str(disposed))
        
        self._refresh_dashboard_list()

    def _refresh_dashboard_list(self):
        # Redraws the table at the bottom of the dashboard based on
        # whichever card is currently selected (e.g. "low_stock",
        # "near_expiry", "today_sales", etc.). It updates the table's
        # title/description text, changes the column headers if needed,
        # runs the matching database query, and fills in the rows
        # (showing a friendly "no records" message if there's nothing
        # to show).
        for r in self.tree.get_children():
            self.tree.delete(r)
            
        view = self.selected_view.get()
        today = datetime.now().strftime("%Y-%m-%d")
        
        if view == "today_sales":
            self.dispose_btn.pack_forget()
        else:
            self.dispose_btn.pack(side="right", pady=4)
            if view == "disposed":
                self.dispose_btn.configure(state="disabled")
            else:
                self.dispose_btn.configure(state="normal")
        
        query = ""
        params = ()
        
        if view == "today_sales":
            self.table_title_var.set("💰  Today's Sales Breakdown")
            self.table_desc_var.set(f"Individual sales transactions registered today ({today}).")
            
            self.tree.heading("Product Name", text="Product Name")
            self.tree.heading("Batch ID", text="Sale ID")
            self.tree.heading("Qty Remaining", text="Quantity Sold")
            self.tree.heading("Expiry Date", text="Total Amount")
            
            query = """
                SELECT p.product_name, s.sale_id, s.quantity_sold, s.total_amount
                FROM sales s JOIN product p ON s.product_id = p.product_id
                WHERE s.sale_date = ? AND s.status = 'active' ORDER BY s.sale_id DESC
            """
            params = (today,)
            
            with db_conn() as c:
                rows = c.execute(query, params).fetchall()
            for r in rows:
                disp = list(r)
                disp[3] = f"₱{float(r[3]):.2f}"
                self.tree.insert("", "end", values=disp)
            if not rows:
                self.tree.insert("", "end", values=("No sales transactions processed today.", "", "", ""))
            return

        self.tree.heading("Product Name", text="Product Name")
        self.tree.heading("Batch ID", text="Batch ID")
        self.tree.heading("Qty Remaining", text="Qty Remaining")
        self.tree.heading("Expiry Date", text="Expiry Date")

        if view == "all_batches":
            self.table_title_var.set("📦  All Active & Fresh Batches")
            self.table_desc_var.set("Listing active batches containing items that are fresh and valid.")
            query = """
                SELECT p.product_name, b.batch_id, b.quantity_remaining, COALESCE(b.expiry_date, 'N/A')
                FROM product_batch b JOIN product p ON b.product_id = p.product_id
                WHERE b.quantity_remaining > 0 AND b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL)
                ORDER BY b.expiry_date ASC
            """
            params = (today,)
        elif view == "low_stock":
                    self.table_title_var.set("⚠  Low Stock Batches")
                    self.table_desc_var.set("Active, fresh batches with 15 or fewer items remaining.")
                    query = """
                        SELECT p.product_name, b.batch_id, b.quantity_remaining, COALESCE(b.expiry_date, 'N/A')
                        FROM product_batch b JOIN product p ON b.product_id = p.product_id
                        WHERE b.quantity_remaining > 0 AND b.quantity_remaining <= 15 AND b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL)
                        ORDER BY b.quantity_remaining ASC
                    """
