        # current products into the table.
        sf = tk.Frame(self, bg=BG)
        sf.pack(fill="x", padx=28, pady=(0, 4))
        self.q = tk.StringVar()
        self.q.trace("w", lambda *_: self._refresh())
        make_search(sf, self.q, "Search by Name / ID / Brand").pack(side="left")

        wrap, self.tree = make_tree(
            self, ["ID", "Name", "Category", "Brand", "Price (₱)", "Total Stock Across Batches"])
        wrap.pack(fill="both", expand=True, padx=28)

        bf = tk.Frame(self, bg=BG)
        bf.pack(fill="x", padx=28, pady=8)
        make_btn(bf, "✏  Edit",    self._edit,   primary=False).pack(side="left", padx=(0, 4))
        make_btn(bf, "🗑  Delete",  self._delete, danger=True).pack(side="left")

        self._refresh()

    def _refresh(self):
        # Reloads the product table from the database, applying whatever
        # text is currently in the search box as a filter (matching
        # against ID, name, category, or brand).
        for r in self.tree.get_children():
            self.tree.delete(r)
        q = self.q.get().strip().lower()
        today = datetime.now().strftime("%Y-%m-%d")
        
        with db_conn() as c:
            rows = c.execute("""
                SELECT p.product_id, p.product_name, p.category, p.brand, p.unit_price, 
                       COALESCE(SUM(CASE WHEN b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL) THEN b.quantity_remaining ELSE 0 END), 0) as total_stock
                FROM product p 
                LEFT JOIN product_batch b ON p.product_id = b.product_id
                WHERE p.status = 'active'
                GROUP BY p.product_id
                ORDER BY p.product_name
            """, (today,)).fetchall()
            
        for r in rows:
            if q and q not in str(r[0]).lower() \
                    and q not in r[1].lower() \
                    and q not in (r[2] or "").lower() \
                    and q not in (r[3] or "").lower():
                continue
            disp = list(r)
            disp[4] = f"₱{float(r[4]):.2f}"
            self.tree.insert("", "end", values=disp)

    def _selected_id(self):
        # Gets the ID of whichever product row is currently highlighted
        # in the table. Shows a warning popup and returns None if nothing
        # is selected (used before Edit/Delete actions).
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Nothing Selected", "Please select a product first.")
            return None
        return self.tree.item(sel[0])["values"][0]

    def _add(self):
        # Opens the "Add Product" popup form. When the user clicks Save,
        # it checks the required fields, generates a new unique product
        # ID, inserts the new product into the database, and refreshes
        # the table.
        def save(d):
            if not d["product_name"]:
                raise ValueError("Product Name is required.")
            if not d["brand"]:
                raise ValueError("Brand Name is required.")
            pid = gen_id("PRD")
            with db_conn() as c:
                c.execute(
                    "INSERT INTO product (product_id, product_name, category, brand, unit_price, status) VALUES(?,?,?,?,?,'active')",
                    (pid, d["product_name"], d["category"], d["brand"],
                     float(d["unit_price"] or 0)))
            self._refresh()

        FormDialog(self.winfo_toplevel(), "Add Product", self._form_fields(), save)

    def _edit(self):
        # Opens the "Edit Product" popup, pre-filled with the selected
        # product's current details. When saved, it validates the
        # required fields and updates that product's record in the
        # database, then refreshes the table.
        pid = self._selected_id()
        if pid is None:
            return
        with db_conn() as c:
            row = c.execute("SELECT product_id, product_name, category, brand, unit_price FROM product WHERE product_id=?", (pid,)).fetchone()
        keys = ["product_id", "product_name", "category", "brand", "unit_price"]
        prefill = dict(zip(keys, row))

        def save(d):
            if not d["product_name"]:
                raise ValueError("Product Name is required.")
            if not d["brand"]:
                raise ValueError("Brand Name is required.")
            with db_conn() as c:
                c.execute("""
                    UPDATE product
                    SET product_name=?, category=?, brand=?, unit_price=?
                    WHERE product_id=?""",
                          (d["product_name"], d["category"], d["brand"],
                           float(d["unit_price"] or 0), pid))
            self._refresh()

        FormDialog(self.winfo_toplevel(), "Edit Product", self._form_fields(), save, prefill)

    def _delete(self):
        # Soft-deletes the selected product: after confirmation, marks
        # both the product and its batches as "deleted" in the database
        # (rather than actually erasing the data), then refreshes the
        # table. Deleted items can later be restored from the Trash Bin.
        pid = self._selected_id()
        if pid is None:
            return
        if not messagebox.askyesno("Delete Product", "Are you sure? This flags the product and associated batches as deleted."):
            return
        with db_conn() as c:
            c.execute("UPDATE product_batch SET status='deleted' WHERE product_id=?", (pid,))
            c.execute("UPDATE product SET status='deleted' WHERE product_id=?", (pid,))
        self._refresh()


