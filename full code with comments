class SalesPage(Page):
    # The "Sales" screen: lets the user record new sales transactions
    # (which also reduces stock from the oldest batches automatically)
    # and view/search/delete past sales.
    def __init__(self, master):
        super().__init__(master)
        hdr = self.page_header("Sales", "Record and view sales transactions")
        make_btn(hdr, "+ New Sale", self._add).pack(side="right")
        self._build()

    def _build(self):
        # Builds the Sales page layout: search bar, the sales table,
        # and a Delete button with a note that deleting a sale doesn't
        # give the stock back. Then loads existing sales.
        sf = tk.Frame(self, bg=BG)
        sf.pack(fill="x", padx=28, pady=(0, 6))
        self.q = tk.StringVar()
        self.q.trace("w", lambda *_: self._refresh())
        make_search(sf, self.q, "Filter by Product / Date / Sale ID").pack(side="left")

        wrap, self.tree = make_tree(self, ["Sale ID", "Date", "Product", "Staff", "Qty Sold", "Total (₱)"])
        wrap.pack(fill="both", expand=True, padx=28)

        bf = tk.Frame(self, bg=BG)
        bf.pack(fill="x", padx=28, pady=8)
        make_btn(bf, "🗑  Delete", self._delete, danger=True).pack(side="left")
        tk.Label(bf, text="Note: deleting a sale does not restore stock.", bg=BG, fg=MUTED, font=("Segoe UI", 8)).pack(side="left", padx=10)

        self._refresh()

    def _refresh(self):
        # Reloads the sales table from the database, filtering by
        # whatever text is in the search box (matches sale ID, date, or
        # product name), and formats amounts as currency.
        for r in self.tree.get_children():
            self.tree.delete(r)
        q = self.q.get().strip().lower()
        with db_conn() as c:
            rows = c.execute("""
                SELECT s.sale_id, s.sale_date, COALESCE(p.product_name, '—'),
                       COALESCE(st.first_name||' '||st.last_name, '—'), s.quantity_sold, s.total_amount
                FROM sales s LEFT JOIN product p ON s.product_id = p.product_id
                LEFT JOIN staff st ON s.staff_id = st.staff_id 
                WHERE s.status='active'
                ORDER BY s.sale_date DESC
            """).fetchall()
        for r in rows:
            if q and q not in str(r[0]).lower() and q not in (r[1] or "").lower() and q not in (r[2] or "").lower():
                continue
            disp = list(r)
            disp[5] = f"₱{float(r[5] or 0):.2f}"
            self.tree.insert("", "end", values=disp)

    def _add(self):
        # Opens the "Record New Sale" popup, listing products (with
        # current stock and price shown) and staff to choose from.
        # On Save, it validates the quantity, checks there's enough
        # stock, calculates the total price, creates a new sale record,
        # and reduces quantity from the oldest (soonest-to-expire)
        # batches first until the sold quantity is fully accounted for.
        today = datetime.now().strftime("%Y-%m-%d")
        with db_conn() as c:
            products = c.execute("""
                SELECT p.product_id, p.product_name, p.unit_price, 
                       COALESCE(SUM(CASE WHEN b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL) THEN b.quantity_remaining ELSE 0 END), 0)
                FROM product p LEFT JOIN product_batch b ON p.product_id = b.product_id
                WHERE p.status = 'active'
                GROUP BY p.product_id ORDER BY p.product_name
            """, (today,)).fetchall()
            staff = c.execute("SELECT staff_id, first_name||' '||last_name FROM staff WHERE status='active' ORDER BY last_name").fetchall()

        if not products:
            messagebox.showwarning("No Products", "Please add products before recording a sale.")
            return

        prod_opts = [f"{p[0]}  –  {p[1]}  (₱{p[2]:.2f}, stock: {p[3]})" for p in products]
        stf_opts  = ([f"{s[0]}  –  {s[1]}" for s in staff] if staff else ["(No staff added)"])

        fields = [
            ("* Product",               "product", "combo", prod_opts),
            ("* Staff Member",          "staff",   "combo", stf_opts),
            ("* Quantity Sold",         "qty",     "entry", []),
            ("* Sale Date (YYYY-MM-DD)","date",    "entry", []),
        ]

        def save(d):
            if not d["product"] or not d["qty"]:
                raise ValueError("Product and Quantity are required fields.")
            pid_raw = d["product"].split("–")[0].strip().split()[0]
            qty     = int(d["qty"])
            date_v  = d["date"] or datetime.now().strftime("%Y-%m-%d")

            with db_conn() as c:
                prod_row = c.execute("SELECT unit_price, product_name FROM product WHERE product_id=?", (pid_raw,)).fetchone()
                total_stock = c.execute("SELECT SUM(quantity_remaining) FROM product_batch WHERE product_id=? AND status = 'active' AND (expiry_date >= ? OR expiry_date IS NULL)", (pid_raw, date_v)).fetchone()[0] or 0
                
            if qty <= 0:
                raise ValueError("Quantity must be greater than 0.")
            if qty > total_stock:
                raise ValueError(f"Insufficient stock! Available: {total_stock}")

            price, pname = prod_row
            total = price * qty
            sale_id = gen_id("SAL")

            stf_id = d["staff"].split("–")[0].strip().split()[0] if "–" in d["staff"] else None

            with db_conn() as c:
                c.execute("INSERT INTO sales (sale_id, sale_date, quantity_sold, total_amount, staff_id, product_id, status) VALUES(?,?,?,?,?,?,'active')", (sale_id, date_v, qty, total, stf_id, pid_raw))
                batches = c.execute("""
                    SELECT batch_id, quantity_remaining FROM product_batch 
                    WHERE product_id=? AND quantity_remaining > 0 AND status = 'active' AND (expiry_date >= ? OR expiry_date IS NULL)
                    ORDER BY expiry_date ASC
                """, (pid_raw, date_v)).fetchall()
                
                left_to_deduct = qty
                for b_id, b_rem in batches:
                    if left_to_deduct <= 0:
                        break
                    if b_rem >= left_to_deduct:
                        c.execute("UPDATE product_batch SET quantity_remaining = quantity_remaining - ? WHERE batch_id=?", (left_to_deduct, b_id))
                        left_to_deduct = 0
                    else:
                        c.execute("UPDATE product_batch SET quantity_remaining = 0 WHERE batch_id=?", (b_id,))
                        left_to_deduct -= b_rem
            self._refresh()

        FormDialog(self.winfo_toplevel(), "Record New Sale", fields, save, {"date": datetime.now().strftime("%Y-%m-%d")})

    def _delete(self):
        # Soft-deletes the selected sale record (marks status as
        # "deleted") after confirmation. Note: it does NOT give the
        # sold stock back to inventory. Then refreshes the table.
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Nothing Selected", "Select a sale to delete.")
            return
        sale_id = self.tree.item(sel[0])["values"][0]
        if not messagebox.askyesno("Delete Sale", "Delete this sale record?\nStock quantity will NOT be restored."):
            return
        with db_conn() as c:
            c.execute("UPDATE sales SET status='deleted' WHERE sale_id=?", (sale_id,))
        self._refresh()


