    def _load_filter_options(self):
        # Refreshes the dropdown lists (Product, Supplier, Staff filters)
        # with the current active names from the database, so the
        # filters always reflect up-to-date records.
        """Fetches distinct active entities dynamically from db to populate comboboxes."""
        with db_conn() as c:
            products = c.execute("SELECT product_name FROM product WHERE status='active' ORDER BY product_name").fetchall()
            suppliers = c.execute("SELECT supplier_name FROM supplier WHERE status='active' ORDER BY supplier_name").fetchall()
            staff = c.execute("SELECT first_name || ' ' || last_name FROM staff WHERE status='active' ORDER BY last_name").fetchall()
        
        prod_list = ["All Products"] + [p[0] for p in products]
        sup_list = ["All Suppliers"] + [s[0] for s in suppliers]
        staff_list = ["All Staff"] + [st[0] for st in staff]
        
        self.cb_prod_filter.configure(values=prod_list)
        self.cb_sup_filter.configure(values=sup_list)
        self.cb_staff_filter.configure(values=staff_list)

    def _show(self, cols, rows, title, filter_mode="none"):
        # Displays a report's results: clears any old table, shows a
        # status message with how many rows were found, decides which
        # filter dropdowns should be visible based on "filter_mode"
        # (e.g. delivery reports show Category/Product/Supplier filters),
        # then builds a fresh table and fills it with the given rows
        # (formatting any money values with the ₱ currency symbol).
        for w in self.tree_host.winfo_children():
            w.destroy()
            
        self.status_lbl.configure(text=f"{title}   ·   {len(rows)} result(s) found", fg=DARK)
        
        # Explicit filter visibility states
        if filter_mode == "delivery":
            self.filters_container.pack(side="right")
            self.cat_frame.pack(side="left")
            self.prod_frame.pack(side="left")
            self.sup_frame.pack(side="left")
            self.staff_frame.pack_forget()
        elif filter_mode == "sales":
            self.filters_container.pack(side="right")
            self.cat_frame.pack(side="left")
            self.prod_frame.pack(side="left")
            self.sup_frame.pack_forget()
            self.staff_frame.pack(side="left")
        elif filter_mode == "cat_only":
            self.filters_container.pack(side="right")
            self.cat_frame.pack(side="left")
            self.prod_frame.pack_forget()
            self.sup_frame.pack_forget()
            self.staff_frame.pack_forget()
        else:
            self.filters_container.pack_forget()

        wrap, tree = make_tree(self.tree_host, cols)
        wrap.pack(fill="both", expand=True)
        for r in rows:
            disp = []
            for v in r:
                if isinstance(v, float):
                    disp.append(f"₱{v:.2f}")
                else:
                    disp.append(v if v is not None else "—")
            tree.insert("", "end", values=disp)

    def _q1(self):
        # Report ①: lists every product currently in stock (with at
        # least 1 fresh/active unit remaining), optionally filtered by
        # category. Shows product name, category, and total stock.
        self._current_report = self._q1
        self.cb_filter.bind("<<ComboboxSelected>>", lambda *_: self._q1())
        selected_cat = self.cat_filter.get()
        today = datetime.now().strftime("%Y-%m-%d")
        
        with db_conn() as c:
            query = """
                SELECT p.product_name, p.category, COALESCE(SUM(CASE WHEN b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL) THEN b.quantity_remaining ELSE 0 END), 0)
                FROM product p LEFT JOIN product_batch b ON p.product_id = b.product_id
                WHERE p.status = 'active'
            """
            params = [today]
            if selected_cat != "All Categories":
                query += " AND p.category = ?"
                params.append(selected_cat)
                
            query += " GROUP BY p.product_id HAVING SUM(CASE WHEN b.status = 'active' AND (b.expiry_date >= ? OR b.expiry_date IS NULL) THEN b.quantity_remaining ELSE 0 END) > 0 ORDER BY p.product_name"
            params.append(today)
            rows = c.execute(query, params).fetchall()
            
        self._show(["Product Name", "Category", "Total Active/Fresh Stock"], rows, "① All Products Currently In Stock", filter_mode="cat_only")

    def _q2(self):
        # Report ②: lists delivery history (date, product, category,
