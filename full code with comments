class FormDialog(tk.Toplevel):
    # A reusable popup window ("dialog box") used everywhere in the app
    # for adding or editing a record (product, staff, supplier, etc.).
    # It builds the input fields automatically from a list you give it,
    # and runs your "on_save" function when the user clicks Save.
    def __init__(self, master, title, fields, on_save, prefill=None):
        # Sets up the popup: window title/size/position, builds every
        # input field described in "fields", optionally fills them with
        # existing values ("prefill" - used when editing), and adds the
        # Save/Cancel buttons at the bottom.
        super().__init__(master)
        self.title(title)
        self.resizable(False, False)
        self.configure(bg=BG)
        self.grab_set()
        self.transient(master)

        n = len(fields)
        rows_count = (n + 1) // 2
        w, h = 640, 64 + (rows_count * 68) + 60
        
        self.update_idletasks()
        px = master.winfo_rootx() + max(0, (master.winfo_width()  - w) // 2)
        py = master.winfo_rooty() + max(0, (master.winfo_height() - h) // 2)
        self.geometry(f"{w}x{h}+{px}+{py}")

        hdr = tk.Frame(self, bg=DARK, height=46)
        hdr.pack(fill="x")
        hdr.pack_propagate(False)
        tk.Label(hdr, text=title, bg=DARK, fg=PANEL,
                 font=("Segoe UI", 11, "bold")).pack(
            side="left", padx=20, pady=0)

        body = tk.Frame(self, bg=BG)
        body.pack(fill="both", expand=True, padx=12, pady=10)

        self.vars = {}
        for i, (lbl, key, kind, opts) in enumerate(fields):
            val = (prefill or {}).get(key, "")
            var = tk.StringVar(value=str(val) if val is not None else "")
            field_entry(body, i, lbl, key, var, kind, opts)
            self.vars[key] = var

        foot = tk.Frame(self, bg=BG)
        foot.pack(fill="x", padx=22, pady=10)
        make_btn(foot, "Cancel", self.destroy, primary=False).pack(
            side="right", padx=(4, 0))
        make_btn(foot, "  Save  ", lambda: self._save(on_save)).pack(
            side="right")

    def _save(self, on_save):
        # Runs when the Save button is clicked. It collects everything the
        # user typed/selected into a dictionary, then hands it to whatever
        # "on_save" function was given to this dialog (e.g. the function
        # that actually inserts a new product into the database).
        # If something goes wrong (like a missing required field), it shows
        # an error popup instead of closing the form.
        data = {k: v.get().strip() for k, v in self.vars.items()}
        try:
            on_save(data)
            self.destroy()
        except Exception as e:
            messagebox.showerror("Error", str(e), parent=self)


