DB_FILE = "grocery.db"


def db_conn():
    # Opens (and returns) a connection to the SQLite database file.
    # Every part of the program that needs to read/write data calls this
    # function first so it has a "pipe" to talk to the database.
    return sqlite3.connect(DB_FILE)


def init_db():
    # Sets up the database the very first time the app runs.
    # It creates all the tables (supplier, staff, product, product_batch,
    # sales, delivery) if they don't already exist, so the app always has
    # somewhere to store its data.
    with db_conn() as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS supplier(
            supplier_id       TEXT PRIMARY KEY,
            supplier_name     TEXT NOT NULL,
            contact_number    TEXT NOT NULL,
            email_address     TEXT NOT NULL,
            delivery_schedule TEXT,
            status            TEXT DEFAULT 'active'
        );
                        
        CREATE TABLE IF NOT EXISTS staff(
            staff_id       TEXT PRIMARY KEY,
            first_name     TEXT NOT NULL,
            middle_initial TEXT,
            last_name      TEXT NOT NULL,
            role           TEXT,
            shift          TEXT,
            contact_number TEXT NOT NULL,
            status         TEXT DEFAULT 'active'
        );
                        
        CREATE TABLE IF NOT EXISTS product(
            product_id     TEXT PRIMARY KEY,
            product_name   TEXT NOT NULL,
            category       TEXT,
            brand          TEXT NOT NULL,
            unit_price     REAL DEFAULT 0,
            status         TEXT DEFAULT 'active'
        );
                        
        CREATE TABLE IF NOT EXISTS product_batch(
            batch_id           TEXT PRIMARY KEY,
            product_id         TEXT,
            delivery_id        TEXT,
            batch_count        INTEGER DEFAULT 0,
            quantity_remaining INTEGER DEFAULT 0,
            expiry_date        TEXT,
            status             TEXT DEFAULT 'active',
            FOREIGN KEY(product_id) REFERENCES product(product_id)
        );
                        
        CREATE TABLE IF NOT EXISTS sales(
            sale_id       TEXT PRIMARY KEY,
            sale_date     TEXT,
            quantity_sold INTEGER,
            total_amount  REAL,
            staff_id      TEXT,
            product_id    TEXT,
            status         TEXT DEFAULT 'active'
        );
                        
        CREATE TABLE IF NOT EXISTS delivery(
            delivery_id       TEXT PRIMARY KEY,
            delivery_date     TEXT,
            quantity_received INTEGER,
            total_cost        REAL,
            supplier_id       TEXT,
            product_id        TEXT,
            staff_id          TEXT,
            status            TEXT DEFAULT 'active'
        );
        """)
        
        for table in ["product", "supplier", "staff", "sales", "delivery"]:
            try:
                c.execute(f"ALTER TABLE {table} ADD COLUMN status TEXT DEFAULT 'active'")
            except sqlite3.OperationalError:
                pass


def gen_id(prefix=""):
    # Creates a short, random, unique ID (like "PRD3F9A1B2C") by combining
    # an optional prefix with part of a randomly generated UUID.
    # Used so every new product/staff/sale/etc. gets its own unique ID.
    return prefix + uuid.uuid4().hex[:8].upper()


