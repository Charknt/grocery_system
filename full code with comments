        # soonest expiry first.
        self._current_report = self._q4
        self.cb_filter.bind("<<ComboboxSelected>>", lambda *_: self._q4())
        selected_cat = self.cat_filter.get()

        with db_conn() as c:
            query = """
                SELECT p.product_name, p.category, b.batch_id, b.quantity_remaining, b.expiry_date
                FROM product_batch b 
                JOIN product p ON b.product_id = p.product_id
                WHERE b.quantity_remaining > 0 AND b.status = 'active'
            """
