class App(tk.Tk):
    # The main application window. Builds the sidebar navigation menu
    # and switches between the different pages (Dashboard, Products,
    # Suppliers, Staff, Sales, Deliveries, Reports, Trash Bin) when the
    # user clicks a nav button. Also runs the live clock in the sidebar.
    NAV_ITEMS = [
        ("🏠", "Dashboard",  DashboardPage),
        ("📦", "Products",   ProductsPage),
        ("🚚", "Suppliers",  SuppliersPage),
        ("👤", "Staff",      StaffPage),
        ("🛒", "Sales",      SalesPage),
        ("📬", "Deliveries", DeliveryPage),
        ("📊", "Reports",    ReportsPage),
        ("♻",  "Trash Bin",  TrashBinPage),
    ]

    def __init__(self):
        # Sets up the main window: title, size, background color, the
        # ttk style theme for dropdowns, builds the sidebar/content
        # layout, shows the first page (Dashboard), and starts the
        # live clock.
        super().__init__()
        self.title("GroceryMS  –  Inventory Management System")
        self.geometry("1140x700")
        self.minsize(920, 620)
        self.configure(bg=BG)

        s = ttk.Style()
        s.theme_use("clam")
        s.configure("TCombobox", fieldbackground=PANEL, background=PANEL, foreground=TEXT, arrowcolor=DARK, selectbackground=MID_BLU)
        s.map("TCombobox", fieldbackground=[("readonly", PANEL)])

        self._build_ui()
        self._show_page(0)
        self._update_clock()

    def _build_ui(self):
        # Builds the overall window layout: the dark sidebar on the
        # right (logo, navigation buttons for every page, version label,
        # live clock) and the main content area on the left where the
        # currently selected page will be displayed.
        self.sidebar = tk.Frame(self, bg=DARK, width=200, bd=1, relief="solid")
        self.sidebar.pack(side="right", fill="y")
        self.sidebar.pack_propagate(False)

        logo = tk.Frame(self.sidebar, bg=DARK, height=88)
        logo.pack(fill="x")
        logo.pack_propagate(False)

        inner = tk.Frame(logo, bg=DARK)
        inner.place(relx=0.5, rely=0.5, anchor="center")
        tk.Label(inner, text="🛒", bg=DARK, fg=PANEL, font=("Segoe UI", 22)).pack(side="left", padx=(0, 8))
        txt_col = tk.Frame(inner, bg=DARK)
        txt_col.pack(side="left")
        tk.Label(txt_col, text="GroceryMS", bg=DARK, fg=PANEL, font=("Segoe UI", 12, "bold")).pack(anchor="w")
        tk.Label(txt_col, text="Inventory System", bg=DARK, fg=ACCENT, font=("Segoe UI", 8, "bold")).pack(anchor="w")

        tk.Frame(self.sidebar, bg=ACCENT, height=2).pack(fill="x", padx=16, pady=2)

        self.nav_buttons = []
        for i, (icon, name, _) in enumerate(self.NAV_ITEMS):
            btn = tk.Button(
                self.sidebar, text=f"  {icon}   {name}", anchor="w", relief="flat", bd=0, bg=DARK, fg=PANEL, font=("Segoe UI", 10, "bold"), cursor="hand2", padx=18, pady=12, activebackground=MID_BLU, activeforeground=PANEL,
                command=lambda i=i: self._show_page(i)
            )
            btn.pack(fill="x", pady=1)
            
            btn.bind("<Enter>", lambda e, b=btn: self._on_hover(b, True))
            btn.bind("<Leave>", lambda e, b=btn: self._on_hover(b, False))
            self.nav_buttons.append(btn)

        # ══════════════════════════════════════════════════════════════
        #  SIDEBAR FOOTER ORDERING
        # ══════════════════════════════════════════════════════════════
        self.clock_lbl = tk.Label(self.sidebar, text="", bg=DARK, fg=PANEL, font=("Segoe UI", 8, "bold"))
        self.clock_lbl.pack(side="bottom", pady=(0, 10))
        
        tk.Frame(self.sidebar, bg=ACCENT, height=2).pack(fill="x", padx=16, side="bottom", pady=(0, 4))

        tk.Label(self.sidebar, text="v2.0 Grocery System", bg=DARK, fg=ACCENT, font=("Segoe UI", 8, "bold")).pack(side="bottom", pady=(4, 2))

        self.content = tk.Frame(self, bg=BG)
        self.content.pack(side="left", fill="both", expand=True)
        self._active_page = None
        self._current_idx = 0

    def _on_hover(self, button, is_entering):
        # Lightens the background of a sidebar button when the mouse
        # hovers over it (and reverts it when the mouse leaves), but
        # skips this effect for whichever button is the currently
        # active page.
        btn_idx = self.nav_buttons.index(button)
        if btn_idx == self._current_idx:
            return  
        if is_entering:
            button.configure(bg=NAV_HOV)
        else:
            button.configure(bg=DARK)

    def _show_page(self, idx):
        # Switches the visible page. Highlights the matching sidebar
        # button as "active", removes whichever page was previously
        # shown, creates a fresh instance of the newly selected page,
        # and displays it in the content area.
        self._current_idx = idx
        for i, btn in enumerate(self.nav_buttons):
            if i == idx:
                btn.configure(bg=MID_BLU, fg=PANEL, font=("Segoe UI", 10, "bold"), relief="sunken")
            else:
                btn.configure(bg=DARK, fg=PANEL, font=("Segoe UI", 10, "bold"), relief="flat")

        if self._active_page:
            self._active_page.destroy()

        PageClass = self.NAV_ITEMS[idx][2]
        self._active_page = PageClass(self.content)
        self._active_page.pack(fill="both", expand=True)

    def _update_clock(self):
        # Updates the sidebar's clock label with the current time and
        # date, then schedules itself to run again in 1 second, keeping
        # the clock "live" for as long as the app is running.
        now = datetime.now()
        time_str = now.strftime("%I:%M:%S %p")
        date_str = now.strftime("%b %d, %Y")
        self.clock_lbl.configure(text=f"{time_str}  ·  {date_str}")
        self.after(1000, self._update_clock)


if __name__ == "__main__":
    init_db()
    app = App()
    app.mainloop()
