class TrashBinPage(Page):
    # The "Trash Bin" screen: lets the user view soft-deleted records
    # (Products, Suppliers, Staff, Sales, Deliveries, Disposed Batches)
    # by category, and restore a selected record back to "active".
    MOD_OPTS = ["Products", "Suppliers", "Staff", "Sales", "Deliveries", "Disposed Batches"]

    def __init__(self, master):
        super().__init__(master)
        hdr = self.page_header("Trash Bin", "Audit and Restore Core System Records")
        
        self.mod_var = tk.StringVar(value=self.MOD_OPTS[0])
        self.mod_var.trace("w", lambda *_: self._on_mod_change())

        cb_frame = tk.Frame(hdr, bg=BG)
        cb_frame.pack(side="right", padx=10)
        tk.Label(cb_frame, text="Module: ", font=("Segoe UI", 9, "bold"), bg=BG, fg=DARK).pack(side="left")
        self.cb = ttk.Combobox(cb_frame, textvariable=self.mod_var, values=self.MOD_OPTS, state="readonly", width=16)
        self.cb.pack(side="left")

        make_btn(hdr, "🔄 Restore Selected", self._restore, primary=True).pack(side="right")
        self._build()

    def _build(self):
        # Builds the area where the deleted-records table will live,
        # then loads whichever module ("Products", "Staff", etc.) is
        # currently selected in the dropdown.
        self.table_host = tk.Frame(self, bg=BG)
        self.table_host.pack(fill="both", expand=True, padx=28, pady=(10, 16))
        self._on_mod_change()

    def _on_mod_change(self):
        # Runs whenever the user picks a different module from the
        # dropdown. Rebuilds the table with the right columns for that
        # type of record (e.g. Products vs Sales have different
        # columns), then loads its deleted rows.
        for w in self.table_host.winfo_children():
            w.destroy()
            
        mod = self.mod_var.get()
        if mod == "Products":
            cols = ["Product ID", "Name", "Category", "Brand", "Unit Price"]
        elif mod == "Suppliers":
            cols = ["Supplier ID", "Supplier Name", "Contact No", "Email Address", "Schedule"]
        elif mod == "Staff":
            cols = ["Staff ID", "First Name", "M.I.", "Last Name", "Role", "Shift"]
        elif mod == "Sales":
            cols = ["Sale ID", "Sale Date", "Product ID", "Qty Sold", "Total Value"]
        elif mod == "Deliveries":
            cols = ["Delivery ID", "Delivery Date", "Product ID", "Qty Received", "Total Cost"]
        elif mod == "Disposed Batches":
            cols = ["Batch ID", "Product Name", "Qty Remaining", "Expiry Date"]

        wrap, self.tree = make_tree(self.table_host, cols, height=16)
        wrap.pack(fill="both", expand=True)
        self._refresh()

    def _refresh(self):
        # Loads the deleted (or disposed) records for the currently
        # selected module from the database and fills the table with
        # them, formatting money columns as currency where relevant.
        for r in self.tree.get_children():
            self.tree.delete(r)
            
        mod = self.mod_var.get()
        query = ""
        
        if mod == "Products":
            query = "SELECT product_id, product_name, category, brand, unit_price FROM product WHERE status='deleted'"
        elif mod == "Suppliers":
            query = "SELECT supplier_id, supplier_name, contact_number, email_address, delivery_schedule FROM supplier WHERE status='deleted'"
        elif mod == "Staff":
            query = "SELECT staff_id, first_name, middle_initial, last_name, role, shift FROM staff WHERE status='deleted'"
        elif mod == "Sales":
            query = "SELECT sale_id, sale_date, product_id, quantity_sold, total_amount FROM sales WHERE status='deleted'"
        elif mod == "Deliveries":
            query = "SELECT delivery_id, delivery_date, product_id, quantity_received, total_cost FROM delivery WHERE status='deleted'"
        elif mod == "Disposed Batches":
            query = """
                SELECT b.batch_id, p.product_name, b.quantity_remaining, COALESCE(b.expiry_date, 'N/A')
                FROM product_batch b JOIN product p ON b.product_id = p.product_id
                WHERE b.status='disposed' ORDER BY b.batch_id DESC
            """

        with db_conn() as c:
            rows = c.execute(query).fetchall()
            
        for r in rows:
            disp = list(r)
            if mod in ["Products", "Sales", "Deliveries"]:
                disp[-1] = f"₱{float(r[-1] or 0):.2f}"
            self.tree.insert("", "end", values=disp)

    def _restore(self):
        # Runs when "Restore Selected" is clicked. Checks a row is
        # selected, asks the user to confirm, then sets that record's
        # status back to "active" in the database (and, for Products/
        # Deliveries, restores their related batches too), shows a
        # success message, and refreshes the table.
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Selection Missing", "Please choose a record line to restore.")
            return
            
        rec_id = self.tree.item(sel[0])["values"][0]
        mod = self.mod_var.get()
        
        if not messagebox.askyesno("Restore Record", f"Are you sure you want to restore {mod[:-1] if mod != 'Disposed Batches' else 'Batch'} record [{rec_id}] back online?"):
            return

        with db_conn() as c:
            if mod == "Products":
                c.execute("UPDATE product SET status='active' WHERE product_id=?", (rec_id,))
                c.execute("UPDATE product_batch SET status='active' WHERE product_id=?", (rec_id,))
            elif mod == "Suppliers":
                c.execute("UPDATE supplier SET status='active' WHERE supplier_id=?", (rec_id,))
            elif mod == "Staff":
                c.execute("UPDATE staff SET status='active' WHERE staff_id=?", (rec_id,))
            elif mod == "Sales":
                c.execute("UPDATE sales SET status='active' WHERE sale_id=?", (rec_id,))
            elif mod == "Deliveries":
                c.execute("UPDATE delivery SET status='active' WHERE delivery_id=?", (rec_id,))
                c.execute("UPDATE product_batch SET status='active' WHERE delivery_id=?", (rec_id,))
            elif mod == "Disposed Batches":
                c.execute("UPDATE product_batch SET status='active' WHERE batch_id=?", (rec_id,))

        messagebox.showinfo("Success", f"{mod[:-1] if mod != 'Disposed Batches' else 'Batch'} record successfully restored.")
        self._refresh()


