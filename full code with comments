class DeliveryPage(Page):
    # The "Deliveries" screen: lets the user record incoming stock
    # deliveries (which automatically creates a new product batch with
    # an expiry date) and view/search/delete past deliveries.
    def __init__(self, master):
        super().__init__(master)
        hdr = self.page_header("Deliveries", "Track incoming stock batches & expiry dates")
        make_btn(hdr, "+ New Delivery", self._add).pack(side="right")
        self._build()

    def _build(self):
        # Builds the Deliveries page layout: search bar, deliveries
        # table, and a Delete button with a note about batch records
        # not being adjusted on delete. Then loads existing deliveries.
        sf = tk.Frame(self, bg=BG)
        sf.pack(fill="x", padx=28, pady=(0, 4))
        self.q = tk.StringVar()
        self.q.trace("w", lambda *_: self._refresh())
        make_search(sf, self.q, "Filter by Product / Supplier / Delivery ID").pack(side="left")

        wrap, self.tree = make_tree(
            self, ["Delivery ID", "Date", "Product", "Supplier", "Qty Received", "Batch Expiry Date", "Total Cost"])
        wrap.pack(fill="both", expand=True, padx=28)

        bf = tk.Frame(self, bg=BG)
        bf.pack(fill="x", padx=28, pady=8)
        make_btn(bf, "🗑  Delete", self._delete, danger=True).pack(side="left")
        tk.Label(bf, text="Note: deleting a delivery does not adjust remaining batch records.", bg=BG, fg=MUTED, font=("Segoe UI", 8)).pack(side="left", padx=10)

        self._refresh()

    def _refresh(self):
        # Reloads the deliveries table from the database, filtering by
        # whatever text is in the search box (matches delivery ID,
        # product name, or supplier name), and formats the cost as
        # currency.
        for r in self.tree.get_children():
            self.tree.delete(r)
        q = self.q.get().strip().lower()
        with db_conn() as c:
            rows = c.execute("""
                SELECT d.delivery_id, d.delivery_date, COALESCE(p.product_name, '—'), COALESCE(s.supplier_name, '—'),
                       d.quantity_received, COALESCE(b.expiry_date, 'N/A'), d.total_cost
                FROM delivery d LEFT JOIN product p ON d.product_id = p.product_id
                LEFT JOIN supplier s ON d.supplier_id = s.supplier_id
                LEFT JOIN product_batch b ON d.delivery_id = b.delivery_id
                WHERE d.status='active'
                ORDER BY d.delivery_date DESC
            """).fetchall()
        for r in rows:
            if q and q not in str(r[0]).lower() and q not in (r[2] or "").lower() and q not in (r[3] or "").lower():
                continue
            disp = list(r)
            disp[6] = f"₱{float(r[6] or 0):.2f}"
            self.tree.insert("", "end", values=disp)

    def _add(self):
        # Opens the "Record New Delivery & Create Batch" popup, listing
        # products, suppliers, and staff to choose from. On Save, it
        # validates the quantity, calculates the total cost, creates a
        # new delivery record AND a brand-new stock batch (with its own
        # expiry date) tied to that delivery, then refreshes the table.
        with db_conn() as c:
            products  = c.execute("SELECT product_id, product_name FROM product WHERE status='active' ORDER BY product_name").fetchall()
            suppliers = c.execute("SELECT supplier_id, supplier_name FROM supplier WHERE status='active' ORDER BY supplier_name").fetchall()
            staff     = c.execute("SELECT staff_id, first_name||' '||last_name FROM staff WHERE status='active' ORDER BY last_name").fetchall()

        if not products or not suppliers:
            messagebox.showwarning("Setup Error", "Ensure active products and suppliers exist first.")
            return

        prod_opts = [f"{p[0]}  –  {p[1]}" for p in products]
        sup_opts  = [f"{s[0]}  –  {s[1]}" for s in suppliers]
        stf_opts  = ([f"{s[0]}  –  {s[1]}" for s in staff] if staff else ["(No staff added)"])

        fields = [
            ("* Product",                 "product",  "combo", prod_opts),
            ("* Supplier",                "supplier", "combo", sup_opts),
            ("* Received By (Staff)",     "staff",    "combo", stf_opts),
            ("* Quantity Received",       "qty",      "entry", []),
            ("* Cost per Unit (₱)",       "cost_per", "entry", []),
            ("* Delivery Date (YYYY-MM-DD)", "date",  "entry", []),
            ("Batch Expiry Date (YYYY-MM-DD) [Optional]", "expiry_date", "entry", []),
        ]

        def save(d):
            if not d["product"] or not d["qty"]:
                raise ValueError("Product and Quantity are required fields.")

            pid = d["product"].split("–")[0].strip().split()[0]
            sid = d["supplier"].split("–")[0].strip().split()[0]
            qty = int(d["qty"])
            if qty <= 0: raise ValueError("Quantity must be greater than 0.")
            
            cost_per = float(d["cost_per"] or 0)
            total    = qty * cost_per
            date_v   = d["date"] or datetime.now().strftime("%Y-%m-%d")
            did      = gen_id("DEL")
            bid      = gen_id("BTC")
            stf_id   = d["staff"].split("–")[0].strip().split()[0] if "–" in d["staff"] else None
            exp_date = d["expiry_date"] if d["expiry_date"] else None

            with db_conn() as c:
                c.execute("INSERT INTO delivery (delivery_id, delivery_date, quantity_received, total_cost, supplier_id, product_id, staff_id, status) VALUES(?,?,?,?,?,?,?,'active')", (did, date_v, qty, total, sid, pid, stf_id))
                c.execute("INSERT INTO product_batch VALUES(?,?,?,?,?,?,?)", (bid, pid, did, qty, qty, exp_date, 'active'))
            self._refresh()

        FormDialog(self.winfo_toplevel(), "Record New Delivery & Create Batch", fields, save,
                   {"date": datetime.now().strftime("%Y-%m-%d")})

    def _delete(self):
        # Soft-deletes the selected delivery record and its linked batch
        # (marks both as "deleted") after confirmation, then refreshes
        # the table.
        sel = self.tree.selection()
        if not sel:
            messagebox.showwarning("Nothing Selected", "Select a delivery to delete.")
            return
        did = self.tree.item(sel[0])["values"][0]
        if not messagebox.askyesno("Delete Delivery", "Delete this delivery record? This hides the delivery and its tracking batch."):
            return
        with db_conn() as c:
            c.execute("UPDATE product_batch SET status='deleted' WHERE delivery_id=?", (did,))
            c.execute("UPDATE delivery SET status='deleted' WHERE delivery_id=?", (did,))
        self._refresh()


