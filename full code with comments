        selected_cat = self.cat_filter.get()
        selected_prod = self.prod_filter.get()
        selected_sup = self.sup_filter.get()

        with db_conn() as c:
            query = """
                SELECT d.delivery_date, p.product_name, p.category, COALESCE(s.supplier_name, '—'), 
                       COALESCE(st.first_name || ' ' || st.last_name, '—'), d.quantity_received, d.total_cost
                FROM delivery d 
                JOIN product p ON d.product_id = p.product_id 
                LEFT JOIN supplier s ON d.supplier_id = s.supplier_id
                LEFT JOIN staff st ON d.staff_id = st.staff_id
                WHERE d.status='active'
            """
            params = []
            if selected_cat != "All Categories":
                query += " AND p.category = ?"
                params.append(selected_cat)
            if selected_prod != "All Products":
                query += " AND p.product_name = ?"
                params.append(selected_prod)
            if selected_sup != "All Suppliers":
                query += " AND s.supplier_name = ?"
                params.append(selected_sup)
                
            query += " ORDER BY d.delivery_date DESC"
            rows = c.execute(query, params).fetchall()
            
        self._show(["Delivery Date", "Product Name", "Category", "Supplier", "Received By (Staff)", "Qty Received", "Total Cost"], rows, "② Consolidated Store Deliveries", filter_mode="delivery")

    def _q3(self):
        # Report ③: lists sales history (date, product, category, staff
        # who logged it, quantity sold, total value), optionally
        # filtered by category, product, and/or staff member.
        self._current_report = self._q3
        self._load_filter_options()
        
        self.cb_filter.bind("<<ComboboxSelected>>", lambda *_: self._q3())
        self.cb_prod_filter.bind("<<ComboboxSelected>>", lambda *_: self._q3())
