        selected_cat = self.cat_filter.get()
        selected_prod = self.prod_filter.get()
        selected_staff = self.staff_filter.get()

        with db_conn() as c:
            query = """
                SELECT s.sale_date, p.product_name, p.category, 
                       COALESCE(st.first_name || ' ' || st.last_name, '—'), s.quantity_sold, s.total_amount
                FROM sales s 
                JOIN product p ON s.product_id = p.product_id 
                LEFT JOIN staff st ON s.staff_id = st.staff_id
                WHERE s.status='active'
            """
            params = []
            if selected_cat != "All Categories":
                query += " AND p.category = ?"
                params.append(selected_cat)
            if selected_prod != "All Products":
                query += " AND p.product_name = ?"
                params.append(selected_prod)
            if selected_staff != "All Staff":
                query += " AND (st.first_name || ' ' || st.last_name) = ?"
                params.append(selected_staff)
                
            query += " ORDER BY s.sale_date DESC"
            rows = c.execute(query, params).fetchall()
            
        self._show(["Sale Date", "Product Name", "Category", "Logged By (Staff)", "Qty Sold", "Total Value"], rows, "③ Consolidated Store Sales Logs", filter_mode="sales")

    def _q4(self):
        # Report ④: lists every active batch that still has stock
        # remaining (product name, category, batch ID, qty remaining,
