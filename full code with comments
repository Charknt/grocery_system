                SELECT p.product_name, b.batch_id, b.quantity_remaining, b.expiry_date
                FROM product_batch b JOIN product p ON b.product_id = p.product_id
                WHERE b.quantity_remaining > 0 AND b.status = 'active' AND b.expiry_date >= ? AND b.expiry_date <= date(?, '+30 days')
                ORDER BY b.expiry_date ASC
