def _apply_tree_style():
    # Configures how all the table/list widgets (Treeviews) look across
    # the whole app: colors, row height, font, and how selected rows
    # are highlighted. This keeps every table looking consistent.
    s = ttk.Style()
    s.theme_use("clam")
    s.configure("G.Treeview",
                background=PANEL, foreground=TEXT,
                rowheight=30, fieldbackground=PANEL,
                font=("Segoe UI", 9), borderwidth=0)
    s.configure("G.Treeview.Heading",
                background=DARK, foreground=PANEL,
                font=("Segoe UI", 9, "bold"), relief="flat")
    s.map("G.Treeview",
          background=[("selected", MID_BLU)],
          foreground=[("selected", PANEL)])
    s.configure("Vertical.TScrollbar",
                background=BG, troughcolor=PANEL,
                arrowcolor=DARK, bordercolor=ACCENT)


def make_tree(parent, cols, height=18):
    # Builds a ready-to-use table (Treeview) with a scrollbar, inside the
    # given parent widget. "cols" is the list of column names to show.
    # Returns the outer frame (to place on screen) and the tree itself
    # (to insert/read rows from).
    _apply_tree_style()
    wrap = tk.Frame(parent, bg=ACCENT, bd=1, relief="solid")
    tree = ttk.Treeview(wrap, columns=cols, show="headings",
                        style="G.Treeview", selectmode="browse",
                        height=height)
    sb = ttk.Scrollbar(wrap, orient="vertical", command=tree.yview)
    tree.configure(yscrollcommand=sb.set)
    tree.pack(side="left", fill="both", expand=True)
    sb.pack(side="right", fill="y")
    for c in cols:
        tree.heading(c, text=c)
        tree.column(c, anchor="center", minwidth=60, width=120)
    return wrap, tree


def make_btn(parent, text, cmd=None, primary=True, danger=False, **kw):
    # Creates a styled button. The look changes depending on its purpose:
    # - danger=True  -> red button (used for "Delete" actions)
    # - primary=True -> blue button (used for main actions like "Save")
    # - otherwise    -> plain/neutral button (used for "Cancel"/"Edit")
    if danger:
        bg, fg = RED, PANEL
    elif primary:
        bg, fg = MID_BLU, PANEL
    else:
        bg, fg = BG, TEXT
        
    btn = tk.Button(
        parent, text=text, command=cmd,
        bg=bg, fg=fg, relief="raised", bd=1,
        font=("Segoe UI", 9, "bold"),
        cursor="hand2", padx=14, pady=6,
        activebackground=ACCENT, activeforeground=TEXT,
        **kw
    )
    return btn


def make_search(parent, var, label="Search"):
    # Builds a small "Label + text box" search bar that the user can type
    # into. "var" is the Tkinter variable that holds whatever the user
    # types, which other code watches to filter table results live.
    f = tk.Frame(parent, bg=BG)
    tk.Label(f, text=label, bg=BG, fg=TEXT,
             font=("Segoe UI", 9, "bold")).pack(side="left", padx=(0, 6))
    entry = tk.Entry(f, textvariable=var,
                     bg=PANEL, fg=TEXT, relief="solid",
                     font=("Segoe UI", 10), width=28,
                     highlightthickness=1,
                     highlightbackground=ACCENT,
                     highlightcolor=MID_BLU,
                     insertbackground=DARK)
    entry.pack(side="left", ipady=4, padx=2)
    return f


def field_entry(parent, index, label, key, var, kind="entry", opts=None):
    # Builds one labeled input field for a form (used inside FormDialog).
    # "index" decides where it sits in a 2-column grid layout.
    # If "kind" is "combo" it becomes a dropdown (using "opts" as choices),
    # otherwise it's a normal text box. Labels starting with "*" get a
    # red asterisk added to mark them as required fields.
    row = index // 2
    col = index % 2
    
    parent.columnconfigure(0, weight=1)
    parent.columnconfigure(1, weight=1)

    cell = tk.Frame(parent, bg=BG)
    cell.grid(row=row, column=col, sticky="ew", padx=10, pady=5)
    
    lbl_frame = tk.Frame(cell, bg=BG)
    lbl_frame.pack(anchor="w", pady=(2, 2))
    
    if label.startswith("*"):
        tk.Label(lbl_frame, text="* ", bg=BG, fg=RED, font=("Segoe UI", 10, "bold")).pack(side="left")
        clean_label = label[1:].strip()
    else:
        clean_label = label

    tk.Label(lbl_frame, text=clean_label, bg=BG, fg=TEXT, font=("Segoe UI", 9, "bold")).pack(side="left")
             
    if kind == "combo":
        w = ttk.Combobox(cell, textvariable=var,
                         values=opts or [], state="readonly",
                         font=("Segoe UI", 9))
        if opts:
            w.current(0)
    else:
        w = tk.Entry(cell, textvariable=var,
                     bg=PANEL, fg=TEXT, relief="solid", bd=1,
                     font=("Segoe UI", 9),
                     highlightthickness=1,
                     highlightbackground=ACCENT,
                     highlightcolor=MID_BLU,
                     insertbackground=DARK)
                     
    w.pack(fill="x", ipady=5)
    return w


